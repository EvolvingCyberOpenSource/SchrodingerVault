{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "schrodinger-vault",
  "version": "0.1.0",
  "identifier": "com.vincentmpalma.schrodingervault",
  "build": {
    "frontendDist": "../src",
    "beforeBundleCommand": "install_name_tool -change /opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib @executable_path/../Frameworks/libcrypto.3.dylib src-tauri/target/release/schrodinger-vault"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "schrodinger-vault",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [
        "/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib"
      ]
    }
  }
}
